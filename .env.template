# =============================================================================
# CNC Tool Wear Prediction & Scrap Risk Signal System -- Environment Template
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`
# file to version control (it is already listed in .gitignore).
#
# Every value below is a PLACEHOLDER. The application runs perfectly well
# with NONE of these set: the Generative AI Narrative Agent automatically
# falls back to a deterministic offline bulletin generator (see
# llm_narrative_agent.py) when Azure OpenAI is not configured, and the
# Snowflake/MQTT/OPC-UA variables are not read by the shipped MVP code at
# all -- they are provided as the config surface a real shop-floor
# integration would plug into (see docs/ARCHITECTURE.md, Section on
# OPC-UA/MQTT/Snowflake integration).
# =============================================================================

# --- Azure OpenAI (Generative AI Narrative Agent) ---------------------------
# Create a resource + GPT-4o deployment in Azure AI Foundry / Azure OpenAI
# Studio, then fill these in. AZURE_OPENAI_DEPLOYMENT_NAME is the *deployment*
# name you chose in Azure, which may differ from the underlying model name.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY_HERE
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# --- Shop-Floor PLC / Controller Connectivity (integration surface) ---------
# OPC-UA endpoint for Siemens Sinumerik / Fanuc controllers exposing an
# OPC-UA server, and/or an MQTT broker if telemetry is bridged that way.
OPCUA_ENDPOINT_URL=opc.tcp://YOUR-MACHINE-CONTROLLER-IP:4840
OPCUA_USERNAME=YOUR_OPCUA_USERNAME
OPCUA_PASSWORD=YOUR_OPCUA_PASSWORD
OPCUA_SECURITY_POLICY=Basic256Sha256

MQTT_BROKER_HOST=YOUR-MQTT-BROKER-HOST
MQTT_BROKER_PORT=8883
MQTT_USERNAME=YOUR_MQTT_USERNAME
MQTT_PASSWORD=YOUR_MQTT_PASSWORD
MQTT_TOPIC_TELEMETRY=plant/cnc/+/telemetry
MQTT_USE_TLS=true

# --- Cloud Feature Store / Data Warehouse -----------------------------------
SNOWFLAKE_ACCOUNT=YOUR_SNOWFLAKE_ACCOUNT_ID
SNOWFLAKE_USER=YOUR_SNOWFLAKE_USER
SNOWFLAKE_PASSWORD=YOUR_SNOWFLAKE_PASSWORD
SNOWFLAKE_WAREHOUSE=CNC_ANALYTICS_WH
SNOWFLAKE_DATABASE=CNC_TOOL_WEAR
SNOWFLAKE_SCHEMA=FEATURE_STORE
SNOWFLAKE_ROLE=CNC_MLOPS_ROLE

# --- Application Settings ----------------------------------------------------
APP_LOG_LEVEL=INFO
MODEL_BACKEND=xgboost
TRAINING_CORPUS_SIZE=1200
